{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Aether",
	"version": "0.1.2",
	"identifier": "com.cas.aether",
	"build": {
		"beforeDevCommand": "pnpm run dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "pnpm run build",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [
			{
				"title": "Aether",
				"width": 1500,
				"height": 1000,
				"titleBarStyle": "Overlay",
				"hiddenTitle": true,
				"transparent": false
			}
		],
		"security": {
			"csp": "default-src 'self'; connect-src 'self' http://localhost:* http://127.0.0.1:* ws://localhost:* ws://127.0.0.1:*; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; media-src 'self' blob:;"
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"createUpdaterArtifacts": true,
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"macOS": {
			"entitlements": "./Entitlements.plist",
			"signingIdentity": null,
			"hardenedRuntime": true
		}
	},
	"plugins": {
		"updater": {
			"endpoints": ["https://sunday-studio.github.io/aether/updates/desktop/stable/latest.json"],
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU4QkRFRTdFQUE0NkYwQUQKUldTdDhFYXFmdTY5V0xVaHNjL3lpNUd1eFhiN3p4OEJVZ3dJU25HcEswTmxLYVJCTjFPMEhkVzIK"
		}
	}
}
